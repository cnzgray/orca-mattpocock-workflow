{
  "name": "orca-mattpocock-workflow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Orca 插件：在右侧栏运行 mattpocock/skills 工作流面板",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:release": "node scripts/build.mjs --release",
    "release:check": "node scripts/release-check.mjs",
    "pack:plugin": "node scripts/pack.mjs",
    "prepare": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}

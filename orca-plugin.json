{
  "manifestVersion": 2,
  "id": "mattpocock-workflow",
  "name": "MattWorkflow",
  "version": "0.1.0",
  "description": "Matt Pocock workflow panel: ticket triage, backlog overview, environment checks, one-click prompt copy, and Orca worktree creation.",
  "license": "MIT",
  "author": {
    "name": "zgray"
  },
  "engines": {
    "orca": ">=1.4.248"
  },
  "execution": "trusted-worker",
  "pluginApi": 1,
  "main": "dist/worker/main.mjs",
  "contributes": {
    "panels": [
      {
        "id": "tickets",
        "title": "MattWorkflow",
        "icon": "flag",
        "entry": "dist/panel/panel.html"
      }
    ],
    "commands": [
      {
        "id": "mattwf.refresh",
        "title": "MattWorkflow: Refresh tickets",
        "when": "workspace"
      },
      {
        "id": "mattwf.open-workspace",
        "title": "MattWorkflow: Open current workspace in Orca",
        "when": "workspace"
      }
    ],
    "events": [
      {
        "on": "workspace.changed"
      }
    ],
    "settings": [
      {
        "key": "language",
        "title": "Language",
        "type": "string",
        "default": "auto"
      }
    ]
  },
  "capabilities": [
    {
      "kind": "workspace:read"
    },
    {
      "kind": "workspace:write"
    },
    {
      "kind": "storage:own"
    },
    {
      "kind": "settings:own"
    },
    {
      "kind": "notifications:show"
    }
  ]
}
